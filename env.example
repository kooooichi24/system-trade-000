# Alpaca API keys (Paper推奨)
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# true: Paper Trading / false: Live
ALPACA_PAPER=true

# データフィード: iex (多くの無料枠で利用可能) / sip (要契約)
ALPACA_DATA_FEED=iex

# Alpaca (paper) API credentials
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# 1 = paper, 0 = live (default: 1)
ALPACA_PAPER=1

# Stock market data feed: "iex" (free) or "sip" (subscription)
ALPACA_DATA_FEED=iex


